# FastAPI Configuration
PROJECT_NAME="TripGenie API"
API_V1_STR="/api/v1"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# JWT Auth Secret
JWT_SECRET="tripgenie_super_secret_jwt_key_2026_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="tripgenie_db"

# LLM Providers
# Options: "openai", "ollama", "fallback"
DEFAULT_LLM_PROVIDER="openai"
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# External API Keys (Optional, fallback mock logic active if empty)
WEATHER_API_KEY=""
GOOGLE_MAPS_API_KEY=""
AMADEUS_API_KEY=""
AMADEUS_API_SECRET=""
