								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/trip/history",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "trip", "history"]
						}
					}
				},
				{
					"name": "Get Trip Details by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/trip/trip-12345",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "trip", "trip-12345"]
						}
					}
				},
				{
					"name": "Delete Trip",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/trip/trip-12345",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "trip", "trip-12345"]
						}
					}
				}
			]
		}
