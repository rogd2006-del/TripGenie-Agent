{
	"info": {
		"_postman_id": "c1f728a0-9a21-4f9e-b921-tripgenie2026",
		"name": "TripGenie Autonomous Travel Planner API",
		"description": "Postman Collection for TripGenie Backend FastAPI Server with Authentication, Trip History, Agent Planner Execution, and PDF Download.",
